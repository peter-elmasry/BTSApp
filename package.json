{
  "name": "btsapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/set-env.mjs --allow-empty && ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "brand": "node scripts/brand-assets.mjs && node scripts/avatars.mjs",
    "seed:owners": "node scripts/seed-owners.mjs",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.25",
    "@fontsource/cairo": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "exceljs": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "lighthouse": "^13.5.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
